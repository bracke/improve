with "../improve_model_runner_runtime.gpr";
with "model_runner_test_support.gpr";

project Runtime_End_To_End is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj-e2e";
   for Exec_Dir use "bin";
   for Main use ("runtime_end_to_end.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Runtime_End_To_End;
