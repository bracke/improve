with "../improve_model_runner_runtime.gpr";

project Runtime_CLI_Black_Box is
   for Languages use ("Ada");
   for Source_Dirs use (".");
   for Object_Dir use "obj-cli-black-box";
   for Exec_Dir use "bin";
   for Main use ("runtime_cli_black_box.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa");
   end Compiler;
end Runtime_CLI_Black_Box;
