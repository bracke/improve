#compdef improve
local improve_commands
improve_commands='(projects findings plan audit apply tasks status refresh verify recover doctor'
improve_commands="$improve_commands config completion manpage help version)"
_arguments \
  "1:command:$improve_commands" \
  '2:operation:(list show approve diff explain bash zsh fish)' \
  '--format[output format]:(terminal json markdown)' \
  '--color[color policy]:(auto always never)' \
  '--severity[finding severity]:(critical high medium low info)' \
  '--status[task status]:(all planned ready running blocked completed failed stale)' \
  '--config[configuration file]:file:_files' '--database[quality database]:file:_files' \
  '--state[Improve state]:file:_files' '*:argument:'
