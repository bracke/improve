package body Improve.Rules is
   use Ada.Strings.Unbounded;
   use Ada_Quality.Types;

   function Make
     (Indicator : Indicator_Id;
      Kind      : Strategy_Kind;
      Title     : String;
      Goal      : String;
      Acceptance, Verification : String) return Remediation_Strategy is
     ((Indicator, Kind, To_Unbounded_String (Title), To_Unbounded_String (Goal),
       To_Unbounded_String (Acceptance), To_Unbounded_String (Verification)));

   type Registry is array (Indicator_Id) of Remediation_Strategy;

   Strategies : constant Registry :=
     [STR_01 => Make (STR_01, Structural_Repair, "Repair the Alire manifest",
        "Restore a present, parseable, policy-compliant Alire manifest.",
        "The manifest exists, parses, and contains the required crate structure.", "STR-01 passes."),
      STR_02 => Make (STR_02, Structural_Repair, "Restore the GPR project structure",
        "Restore a valid project file and its declared source relationship.",
        "The selected GPR project loads and validates without structural errors.", "STR-02 passes."),
      STR_03 => Make (STR_03, Structural_Repair, "Correct the project source layout",
        "Bring source directories and Ada units into the required project layout.",
        "Every affected source is in an allowed directory and remains declared by the project.", "STR-03 passes."),
      STR_04 => Make (STR_04, Structural_Repair, "Establish the test subcrate",
        "Provide the required separately buildable test crate.",
        "The test manifest, GPR file, and registered test executable are present and valid.", "STR-04 passes."),
      STR_05 => Make (STR_05, Structural_Repair, "Implement the release checker",
        "Provide the project release-check entry point required by policy.",
        "The checker is discoverable, noninteractive, and reports failures through its exit status.", "STR-05 passes."),
      BLD_01 => Make (BLD_01, Build_Repair, "Repair the normal build",
        "Resolve the evidenced root cause of compilation failure.",
        "The normal Ada 2022 build succeeds without weakening configured checks.", "BLD-01 passes."),
      BLD_02 => Make (BLD_02, Build_Repair, "Repair the validation build",
        "Resolve errors specific to the validation build profile.",
        "The validation build succeeds with its warning and assertion policy intact.", "BLD-02 passes."),
      BLD_03 => Make (BLD_03, Build_Repair, "Resolve compiler warnings",
        "Eliminate the evidenced compiler warnings by root cause.",
        "The warning gate succeeds; warnings are not hidden or globally disabled.", "BLD-03 passes."),
      BLD_04 => Make (BLD_04, Investigation, "Restore toolchain identification",
        "Correct configuration or detection so the required Ada toolchain is identified.",
        "The selected toolchain is explicit, supported, and reproducibly detected.", "BLD-04 passes."),
      TST_01 => Make (TST_01, Test_Repair, "Repair the test suite",
        "Resolve evidenced test failures and missing test prerequisites.",
        "The registered AUnit test action completes successfully and deterministically.", "TST-01 passes."),
      TST_02 => Make (TST_02, Test_Repair, "Register the project tests",
        "Restore discoverable, executable project tests.",
        "The expected tests are registered and the test action executes them.", "TST-02 passes."),
      TST_03 => Make (TST_03, Coverage_Improvement, "Improve production-line coverage",
        "Add evidence-backed tests for uncovered production behavior until policy is met.",
        "Production line coverage is at least 90 percent without exclusions that weaken the baseline intent.",
        "TST-03 passes at the configured threshold."),
      TST_04 => Make (TST_04, Test_Repair, "Restore deterministic test execution",
        "Remove evidenced nondeterminism from execution, normalized output, or artifacts.",
        "Repeated equivalent test runs produce the same normalized result and artifacts.", "TST-04 passes."),
      SRC_01 => Make (SRC_01, Source_Refactoring, "Correct source formatting",
        "Apply the configured Ada source formatting policy to the evidenced units.",
        "Affected source satisfies formatting policy without semantic changes.", "SRC-01 passes."),
      SRC_02 => Make (SRC_02, Source_Refactoring, "Correct Ada file and unit names",
        "Make source filenames correspond to their declared Ada units.",
        "Every affected unit has its GNAT-conventional filename and all project references remain valid.",
        "SRC-02 passes."),
      SRC_03 => Make (SRC_03, Source_Refactoring, "Reduce decision complexity",
        "Decompose the evidenced decision logic while preserving behavior.",
        "Affected decisions meet complexity policy and focused regression tests preserve behavior.", "SRC-03 passes."),
      SRC_04 => Make (SRC_04, Source_Refactoring, "Resolve source hygiene violations",
        "Remove the evidenced source hygiene defects without suppressing the rule.",
        "No affected unit violates the reported hygiene rule.", "SRC-04 passes."),
      SRC_05 => Make (SRC_05, Source_Refactoring, "Audit exception handling",
        "Correct overly broad or unaudited exception handling in the evidenced scope.",
        "Each affected handler has bounded behavior, preserves actionable diagnostics, and satisfies policy.",
        "SRC-05 passes."),
      SRC_06 => Make (SRC_06, Source_Refactoring, "Refactor oversized source files",
        "Split evidenced oversized units along cohesive package boundaries.",
        "Affected files meet size policy and public behavior remains covered.", "SRC-06 passes."),
      DOC_01 => Make (DOC_01, Documentation_Repair, "Document public declarations",
        "Add accurate GNATdoc documentation to the evidenced public declarations.",
        "Every affected public declaration has complete GNATdoc-compatible documentation.", "DOC-01 passes."),
      DOC_02 => Make (DOC_02, Documentation_Repair, "Repair GNATdoc generation",
        "Resolve the evidenced documentation-generation errors.",
        "GNATdoc completes without errors or warnings for the project API.", "DOC-02 passes."),
      DOC_03 => Make (DOC_03, Documentation_Repair, "Complete required project documentation",
        "Add or correct the specific project documentation required by policy.",
        "Every required document exists and contains the required project-specific information.", "DOC-03 passes."),
      DEP_01 => Make (DEP_01, Dependency_Repair, "Repair dependency resolution",
        "Resolve the evidenced dependency constraints or availability problem.",
        "Alire resolves the declared dependency set reproducibly.", "DEP-01 passes."),
      DEP_02 => Make (DEP_02, Dependency_Repair, "Remove prohibited local path pins",
        "Replace release-manifest local pins without changing intended dependency semantics.",
        "The releasable manifest contains no prohibited path pin and resolves successfully.", "DEP-02 passes."),
      DEP_03 => Make (DEP_03, Dependency_Repair, "Repair the dependency solution build",
        "Resolve build failures in the selected dependency solution.",
        "The complete resolved dependency graph builds under the selected profile.", "DEP-03 passes."),
      SEC_01 => Make (SEC_01, Security_Repair, "Remove embedded secrets safely",
        "Remove evidenced secret assignments and use an authorized secret source.",
        "No secret remains in source or history produced by the remediation, and required rotation is documented.",
        "SEC-01 passes."),
      SEC_02 => Make (SEC_02, Security_Repair, "Replace prohibited shell execution",
        "Replace the evidenced shell command with an argument-safe Ada API or remove it.",
        "No prohibited shell interpolation remains and untrusted text cannot become a command.", "SEC-02 passes."),
      SEC_03 => Make (SEC_03, Security_Repair, "Remove prohibited artifacts or links",
        "Remove the evidenced artifact or unsafe symbolic link and prevent recurrence.",
        "No prohibited artifact or unsafe link is present in the measured project tree.", "SEC-03 passes."),
      REL_01 => Make (REL_01, Release_Repair, "Repair release verification",
        "Resolve the evidenced release-check failure without weakening its gate.",
        "The release checker completes successfully with all original gates enabled.", "REL-01 passes."),
      REL_02 => Make (REL_02, Release_Repair, "Correct license metadata and files",
        "Make declared licensing and repository license files consistent and complete.",
        "License metadata is valid and every required license file is present.", "REL-02 passes."),
      REL_03 => Make (REL_03, Release_Repair, "Complete release manifest fields",
        "Supply accurate values for the evidenced missing or invalid release fields.",
        "The release manifest contains all required valid fields.", "REL-03 passes."),
      REL_04 => Make (REL_04, Investigation, "Investigate source mutation during measurement",
        "Identify and eliminate the process that changed measured source state.",
        "Equivalent measurement leaves the source fingerprint unchanged.", "REL-04 passes."),
      PRF_01 => Make (PRF_01, Proof_Repair, "Repair applicable SPARK proofs",
        "Resolve the evidenced proof failures without disabling applicable obligations.",
        "All proofs required by project policy succeed at the configured level.", "PRF-01 passes.")];

   function Strategy_For (Indicator : Indicator_Id) return Remediation_Strategy is (Strategies (Indicator));

   function Image (Kind : Strategy_Kind) return String is
     (case Kind is
         when Structural_Repair => "structural-repair",
         when Build_Repair => "build-repair",
         when Test_Repair => "test-repair",
         when Coverage_Improvement => "coverage-improvement",
         when Source_Refactoring => "source-refactoring",
         when Documentation_Repair => "documentation-repair",
         when Dependency_Repair => "dependency-repair",
         when Security_Repair => "security-repair",
         when Release_Repair => "release-repair",
         when Proof_Repair => "proof-repair",
         when Investigation => "investigation");
end Improve.Rules;
