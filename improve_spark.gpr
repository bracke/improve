project Improve_Spark is
   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Source_Files use ("improve.ads", "improve.adb");
   for Object_Dir use "proof/obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatyM120", "-gnata");
   end Compiler;
end Improve_Spark;
