{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bracke/improve/schemas/improve-output-v1.schema.json",
  "title": "Improve CLI output version 1",
  "type": "object",
  "required": ["schema_version", "command", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "command": { "type": "string" },
    "data": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "positive": { "type": "integer", "minimum": 1 },
    "natural": { "type": "integer", "minimum": 0 },
    "strings": { "type": "array", "items": { "type": "string" } },
    "text": {
      "type": "object", "required": ["kind", "text"],
      "properties": { "kind": { "type": "string" }, "text": { "type": "string" } },
      "additionalProperties": false
    },
    "project": {
      "type": "object", "required": ["id", "path", "enabled", "removed"],
      "properties": { "id": { "$ref": "#/$defs/positive" }, "path": { "type": "string" },
        "enabled": { "type": "boolean" }, "removed": { "type": "boolean" } },
      "additionalProperties": false
    },
    "projects": {
      "type": "object", "required": ["snapshot", "projects"],
      "properties": { "snapshot": { "type": "string" },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } } },
      "additionalProperties": false
    },
    "finding": {
      "type": "object", "required": ["indicator", "rule", "severity", "path", "line", "fingerprint", "subject",
        "message", "evidence", "candidate_kind", "indicator_level"],
      "properties": { "indicator": { "type": "string" }, "rule": { "type": "string" },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] }, "path": { "type": "string" },
        "line": { "$ref": "#/$defs/natural" }, "fingerprint": { "type": "string" },
        "subject": { "type": "string" }, "message": { "type": "string" }, "evidence": { "type": "string" },
        "candidate_kind": { "type": "string" }, "indicator_level": { "type": "boolean" } },
      "additionalProperties": false
    },
    "findings": {
      "type": "object", "required": ["project_id", "project", "run_id", "assessment", "snapshot", "findings"],
      "properties": { "project_id": { "$ref": "#/$defs/positive" }, "project": { "type": "string" },
        "run_id": { "$ref": "#/$defs/positive" }, "assessment": { "type": "string" },
        "snapshot": { "type": "string" }, "next_cursor": { "type": "string" },
        "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } } },
      "additionalProperties": false
    },
    "planTask": {
      "type": "object", "required": ["id", "title", "category", "priority", "candidate_kind", "goal", "problem",
        "evidence", "scope", "out_of_scope", "requirements", "acceptance", "verification", "confidence",
        "requires_review", "files", "findings", "depends_on"],
      "properties": { "id": { "type": "string" }, "title": { "type": "string" },
        "category": { "type": "string" }, "priority": { "type": "string" }, "candidate_kind": { "type": "string" },
        "goal": { "type": "string" }, "problem": { "type": "string" }, "evidence": { "type": "string" },
        "scope": { "type": "string" }, "out_of_scope": { "type": "string" }, "requirements": { "type": "string" },
        "acceptance": { "type": "string" }, "verification": { "type": "string" },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }, "requires_review": { "type": "boolean" },
        "files": { "$ref": "#/$defs/strings" }, "findings": { "$ref": "#/$defs/strings" },
        "depends_on": { "$ref": "#/$defs/strings" } }, "additionalProperties": false
    },
    "plan": {
      "type": "object", "required": ["plan_id", "revision", "project_id", "project", "run_id",
        "assessment_fingerprint", "working_source_fingerprint", "fingerprint", "planner", "dry_run", "stored", "tasks"],
      "properties": { "plan_id": { "type": "string" }, "revision": { "$ref": "#/$defs/positive" },
        "project_id": { "$ref": "#/$defs/positive" }, "project": { "type": "string" },
        "run_id": { "$ref": "#/$defs/positive" }, "assessment_fingerprint": { "type": "string" },
        "working_source_fingerprint": { "type": "string" }, "fingerprint": { "type": "string" },
        "planner": { "type": "string" }, "dry_run": { "type": "boolean" }, "stored": { "type": "boolean" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/planTask" } } }, "additionalProperties": false
    },
    "plans": { "type": "object", "required": ["plans"], "properties": { "plans": { "type": "array", "items": {
      "type": "object",
      "required": ["plan_id", "revision", "project_id", "project", "run_id", "task_count", "fingerprint"],
      "properties": { "plan_id": { "type": "string" }, "revision": { "$ref": "#/$defs/positive" },
        "project_id": { "$ref": "#/$defs/positive" }, "project": { "type": "string" },
        "run_id": { "$ref": "#/$defs/positive" }, "task_count": { "$ref": "#/$defs/natural" },
        "fingerprint": { "type": "string" } }, "additionalProperties": false } },
        "next_cursor": { "type": "string" } }, "additionalProperties": false },
    "approval": { "type": "object", "required": ["plan_id", "revision", "fingerprint", "approved"],
      "properties": { "plan_id": { "type": "string" }, "revision": { "$ref": "#/$defs/positive" },
        "fingerprint": { "type": "string" }, "approved": { "const": true } }, "additionalProperties": false },
    "comparison": { "type": "object", "required": ["plan_id", "from_revision", "to_revision", "changed", "reasons"],
      "properties": { "plan_id": { "type": "string" }, "from_revision": { "$ref": "#/$defs/positive" },
        "to_revision": { "$ref": "#/$defs/positive" }, "changed": { "type": "boolean" },
        "reasons": { "$ref": "#/$defs/strings" } }, "additionalProperties": false },
    "diagnostics": { "type": "object", "required": ["healthy", "checks"], "properties": {
      "healthy": { "type": "boolean" }, "checks": { "type": "array", "items": { "type": "object",
        "required": ["name", "status", "detail"], "properties": { "name": { "type": "string" },
          "status": { "enum": ["pass", "warning", "fail"] }, "detail": { "type": "string" } },
        "additionalProperties": false } } }, "additionalProperties": false },
    "publication": { "type": "object", "required": ["plan_id", "task_kind", "dry_run", "tasks"], "properties": {
      "plan_id": { "type": "string" }, "task_kind": { "type": "string" }, "dry_run": { "type": "boolean" },
      "tasks": { "type": "array", "items": { "type": "object",
        "required": ["improve_task_id", "harness_task_id", "origin", "state", "recovered"],
        "properties": { "improve_task_id": { "type": "string" }, "harness_task_id": { "type": "string" },
          "origin": { "type": "string" }, "state": { "type": "string" }, "recovered": { "type": "boolean" } },
        "additionalProperties": false } } }, "additionalProperties": false },
    "verification": { "type": "object", "required": ["plan_id", "baseline_run", "verification_run", "outcome",
      "plan_outcome", "project_outcome", "comparable", "new_critical", "explanation", "tasks"], "properties": {
      "plan_id": { "type": "string" }, "baseline_run": { "$ref": "#/$defs/positive" },
      "verification_run": { "$ref": "#/$defs/positive" }, "outcome": { "type": "string" },
      "plan_outcome": { "type": "string" }, "project_outcome": { "type": "string" },
      "comparable": { "type": "boolean" }, "new_critical": { "$ref": "#/$defs/natural" },
      "explanation": { "type": "string" }, "tasks": { "type": "array", "items": { "type": "object",
        "required": ["task_id", "outcome", "matched", "total", "explanation"], "properties": {
          "task_id": { "type": "string" }, "outcome": { "type": "string" },
          "matched": { "$ref": "#/$defs/natural" }, "total": { "$ref": "#/$defs/natural" },
          "explanation": { "type": "string" } }, "additionalProperties": false } } }, "additionalProperties": false },
    "taskView": { "type": "object", "required": ["project_id", "project", "plan_id", "improve_task_id",
      "harness_task_id", "title", "harness_state", "quality_outcome", "verification_run", "verification_freshness",
      "verification_current", "status"], "properties": { "project_id": { "$ref": "#/$defs/positive" },
      "project": { "type": "string" }, "plan_id": { "type": "string" }, "improve_task_id": { "type": "string" },
      "harness_task_id": { "type": "string" }, "title": { "type": "string" }, "harness_state": { "type": "string" },
      "quality_outcome": { "type": "string" }, "verification_run": { "$ref": "#/$defs/natural" },
      "verification_freshness": { "type": "string" }, "verification_current": { "type": "boolean" },
      "status": { "type": "string" } }, "additionalProperties": false },
    "tasks": { "type": "object", "required": ["filter", "tasks"], "properties": { "filter": { "type": "string" },
      "next_cursor": { "type": "string" },
      "tasks": { "type": "array", "items": { "$ref": "#/$defs/taskView" } } }, "additionalProperties": false },
    "status": { "type": "object", "required": ["projects"], "properties": { "projects": { "type": "array",
      "items": { "type": "object", "required": ["project_id", "project", "baseline_run", "latest_run", "plan_count",
        "plan_quality", "plan_verification_run", "plan_verification_current", "previous_plan_quality",
        "project_quality",
        "project_verification_run", "project_verification_current", "previous_project_quality", "tasks", "findings"],
        "properties": { "project_id": { "$ref": "#/$defs/positive" }, "project": { "type": "string" },
          "baseline_run": { "$ref": "#/$defs/positive" }, "latest_run": { "$ref": "#/$defs/positive" },
          "plan_count": { "$ref": "#/$defs/natural" }, "plan_quality": { "type": "string" },
          "plan_verification_run": { "$ref": "#/$defs/natural" }, "plan_verification_current": { "type": "boolean" },
          "previous_plan_quality": { "type": "string" }, "project_quality": { "type": "string" },
          "project_verification_run": { "$ref": "#/$defs/natural" },
          "project_verification_current": { "type": "boolean" }, "previous_project_quality": { "type": "string" },
          "tasks": { "type": "array", "items": { "$ref": "#/$defs/taskView" } },
          "findings": { "type": "object", "required": ["resolved", "outstanding", "not_measurable", "regressed",
            "superseded", "previously_resolved", "unverified"],
            "properties": { "resolved": { "$ref": "#/$defs/natural" },
            "outstanding": { "$ref": "#/$defs/natural" }, "not_measurable": { "$ref": "#/$defs/natural" },
            "regressed": { "$ref": "#/$defs/natural" }, "superseded": { "$ref": "#/$defs/natural" },
            "previously_resolved": { "$ref": "#/$defs/natural" }, "unverified": { "$ref": "#/$defs/natural" } },
            "additionalProperties": false } }, "additionalProperties": false } } }, "additionalProperties": false },
    "recovery": { "type": "object", "required": ["operations_recovered", "tasks_recovered"], "properties": {
      "operations_recovered": { "$ref": "#/$defs/natural" }, "tasks_recovered": { "$ref": "#/$defs/natural" } },
      "additionalProperties": false },
    "graph": { "type": "object", "required": ["plan_id", "revision", "nodes", "edges"], "properties": {
      "plan_id": { "type": "string" }, "revision": { "$ref": "#/$defs/positive" },
      "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "title", "priority"],
        "properties": { "id": { "type": "string" }, "title": { "type": "string" },
          "priority": { "type": "string" } }, "additionalProperties": false } },
      "edges": { "type": "array", "items": { "type": "object", "required": ["from", "to"],
        "properties": { "from": { "type": "string" }, "to": { "type": "string" } },
        "additionalProperties": false } } }, "additionalProperties": false },
    "audit": { "type": "object", "required": ["plan_id", "revision", "fingerprint", "approved", "project_id",
      "project", "database_id", "baseline_run", "source_id", "policy_id", "toolchain_id", "evidence_id", "planner_id",
      "finding_keys", "tasks", "publications", "verifications", "canonical_payload", "bundle_digest"], "properties": {
      "plan_id": { "type": "string" }, "revision": { "$ref": "#/$defs/positive" }, "fingerprint": { "type": "string" },
      "approved": { "type": "boolean" }, "project_id": { "$ref": "#/$defs/positive" }, "project": { "type": "string" },
      "database_id": { "type": "string" }, "baseline_run": { "$ref": "#/$defs/positive" },
      "source_id": { "type": "string" }, "policy_id": { "type": "string" }, "toolchain_id": { "type": "string" },
      "evidence_id": { "type": "string" }, "planner_id": { "type": "string" },
      "canonical_payload": { "type": "string" }, "bundle_digest": { "type": "string" },
      "next_cursor": { "type": "string" },
      "public_key": { "type": "string" }, "signature": { "type": "string" },
      "finding_keys": { "$ref": "#/$defs/strings" },
      "tasks": { "type": "array", "items": { "type": "object", "required": ["id", "title", "contract_fingerprint"],
        "properties": { "id": { "type": "string" }, "title": { "type": "string" },
          "contract_fingerprint": { "type": "string" } }, "additionalProperties": false } },
      "publications": { "type": "array", "items": { "type": "object",
        "required": ["improve_task_id", "harness_task_id", "origin", "contract", "state", "plan_revision"],
        "properties": { "improve_task_id": { "type": "string" }, "harness_task_id": { "type": "string" },
          "origin": { "type": "string" }, "contract": { "type": "string" }, "state": { "type": "string" },
          "plan_revision": { "$ref": "#/$defs/positive" } }, "additionalProperties": false } },
      "verifications": { "type": "array", "items": { "type": "object",
        "required": ["scope", "task_id", "plan_revision", "contract_fingerprint", "assessment_id", "outcome",
          "comparable", "explanation"],
        "properties": { "scope": { "type": "string" }, "task_id": { "type": "string" },
          "plan_revision": { "$ref": "#/$defs/positive" }, "contract_fingerprint": { "type": "string" },
          "assessment_id": { "$ref": "#/$defs/positive" }, "outcome": { "type": "string" },
          "comparable": { "type": "boolean" }, "explanation": { "type": "string" } }, "additionalProperties": false } }
      }, "additionalProperties": false },
    "error": { "type": "object", "required": ["code", "category", "detail"], "properties": {
      "code": { "type": "string", "pattern": "^IMP-E-[A-Z]+$" },
      "category": { "enum": ["invalid_input", "unavailable_dependency", "invalid_state", "internal_failure"] },
      "detail": { "type": "string" }, "hint": { "type": "string" } }, "additionalProperties": false }
  },
  "oneOf": [
    { "properties": { "command": { "const": "projects" }, "data": { "$ref": "#/$defs/projects" } } },
    { "properties": { "command": { "const": "findings" }, "data": { "$ref": "#/$defs/findings" } } },
    { "properties": { "command": { "const": "plan" }, "data": { "$ref": "#/$defs/plan" } } },
    { "properties": { "command": { "const": "plan list" }, "data": { "$ref": "#/$defs/plans" } } },
    { "properties": { "command": { "const": "plan approve" }, "data": { "$ref": "#/$defs/approval" } } },
    { "properties": { "command": { "enum": ["plan diff", "plan explain"] },
      "data": { "$ref": "#/$defs/comparison" } } },
    { "properties": { "command": { "const": "plan graph" }, "data": { "$ref": "#/$defs/graph" } } },
    { "properties": { "command": { "const": "audit" }, "data": { "$ref": "#/$defs/audit" } } },
    { "properties": { "command": { "const": "apply" }, "data": { "$ref": "#/$defs/publication" } } },
    { "properties": { "command": { "const": "tasks" }, "data": { "$ref": "#/$defs/tasks" } } },
    { "properties": { "command": { "const": "status" }, "data": { "$ref": "#/$defs/status" } } },
    { "properties": { "command": { "enum": ["refresh", "verify"] }, "data": { "$ref": "#/$defs/verification" } } },
    { "properties": { "command": { "const": "recover" }, "data": { "$ref": "#/$defs/recovery" } } },
    { "properties": { "command": { "const": "doctor" }, "data": { "$ref": "#/$defs/diagnostics" } } },
    { "properties": { "command": { "const": "error" }, "data": { "$ref": "#/$defs/error" } } },
    { "properties": { "command": { "enum": ["config", "audit verify", "completion", "manpage", "help", "version"] },
      "data": { "$ref": "#/$defs/text" } } }
  ]
}
