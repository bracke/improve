with "config/improve_config.gpr";
with "database";
with "ada_quality";
with "jsonlib";
with "messages";
with "terminal_styles";
with "project_tools";
with "hostkit";
with "model_runner";

project Improve is
   type Boolean_Text is ("false", "true");
   Warnings_As_Errors : Boolean_Text := external ("IMPROVE_WARNINGS_AS_ERRORS", "false");
   Warning_Switches := ();

   case Warnings_As_Errors is
      when "false" => null;
      when "true"  => Warning_Switches := ("-gnatwe");
   end case;
   case Improve_Config.Build_Profile is
      when "validation" => Warning_Switches := ("-gnatwe");
      when others => null;
   end case;

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("improve_main.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatyM120", "-gnata", "-gnatwa", "-gnatVa") & Warning_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;

   package Builder is
      for Executable ("improve_main.adb") use "improve";
   end Builder;
end Improve;

